# =============================================================================
# CORELBASE PRIVATE LIMITED — ROOT APACHE CONFIGURATION (.htaccess)
# Compatible with aaPanel Apache 2.4+ & LiteSpeed Web Server
# =============================================================================

Options -Indexes -MultiViews
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Clean URLs for /track and /verify (Sections 17 & 20)
    RewriteRule ^track/?$ track.php [L,QSA]
    RewriteRule ^verify/?$ verify.php [L,QSA]

    # Block direct web access to sensitive SQL, lock, log, and markdown files
    RewriteRule ^(.*)\.(sql|lock|log|ini|sh|bak|env)$ - [F,L,NC]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Protect hidden dotfiles (.htaccess, .git, .env)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
